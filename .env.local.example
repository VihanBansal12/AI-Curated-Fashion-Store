# AI Features (Optional - can use rule-based system)
# OPENAI_API_KEY=your_openai_key

# Real Weather (Optional - can use manual selection)
# OPENWEATHER_API_KEY=your_weather_key

# User Accounts (Optional - can start without auth)
# NEXTAUTH_SECRET=your_auth_secret
# NEXTAUTH_URL=http://localhost:3000

# Database (Optional - can use local storage only)
# DATABASE_URL=your_database_url

# Feature Flags (Set to false to start without APIs)
ENABLE_AI_FEATURES=false
ENABLE_REAL_WEATHER=false
ENABLE_USER_ACCOUNTS=false